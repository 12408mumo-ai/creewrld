# Supabase — copy to .env.local (git-ignored) for local development.
#
# Both naming schemes work: VITE_* is the Vite convention, NEXT_PUBLIC_* is what
# the Vercel project already uses, and the client accepts either. Only the anon /
# publishable key ever belongs here — never the service_role / secret key.
#
# Find them in Supabase → Project Settings → API:
#   Project URL   → VITE_SUPABASE_URL
#   anon / publishable key → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The NEXT_PUBLIC_* spellings are accepted too:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to "off" to skip the live catalogue subscription.
# VITE_SUPABASE_REALTIME=on
